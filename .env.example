# OrchDock settings for this machine. Copy this file to .env next to the
# orchdock / orchdockw programs and change what you need. .env is never
# committed; a variable set in the real environment always wins.
#
# Only ORCHDOCK_* keys are read.

# Where OrchDock keeps its data (items, run logs, history, icons).
# Default: a "data" folder next to the programs when that folder is writable,
# otherwise your per-user data folder (Windows: %LOCALAPPDATA%\orchdock,
# macOS: ~/Library/Application Support/orchdock, Linux: ~/.local/share/orchdock).
# ORCHDOCK_HOME=
